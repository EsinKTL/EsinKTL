name: Update README

on:
  schedule:
    - cron: '0 0 * * *' # Her gün UTC 00:00'da
  workflow_dispatch:

jobs:
  update-readme:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repo
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.x'

      - name: Update README (placeholder script)
        run: |
          echo "Updating progress badges or stats if needed"
          # Burada Python veya bash script ile dinamik yüzdeleri değiştirebilirsin

      - name: Commit and Push
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add README.md
          git commit -m "Automated README update"
          git push
